<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN APP CONTENT VIEW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8FAFC">

        <!-- Header Bar with Show Nav Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <ImageButton
                android:id="@+id/btnShowNav"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Show Nav" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHERE IS MY MONEY?"
                    android:textColor="#0F5132"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Account: Main Account"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSync"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_popup_sync"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sync data" />

            <ImageButton
                android:id="@+id/btnToggleDarkMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_moon"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#0F5132"
                android:contentDescription="Switch to dark mode" />
        </LinearLayout>

        <!-- CONTAINER FOR SWITCHABLE TABS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 1. DASHBOARD VIEW -->
            <LinearLayout
                android:id="@+id/viewDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0F5132"
                    android:padding="18dp"
                    android:elevation="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REMAINING BALANCE"
                        android:textColor="#A3E635"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvRemainingBalance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="₱0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <ImageButton
                            android:id="@+id/btnToggleAmounts"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_eye_open"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#FFFFFF"
                            android:contentDescription="Hide amounts" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E293B"
                        android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Budget/Income"
                                android:textColor="#D1FAE5"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTotalIncome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#34D399"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Expenses"
                                android:textColor="#FEE2E2"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTotalExpenses"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#F87171"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReportSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="This week: ₱0.00 spent  •  This month: ₱0.00 spent"
                        android:textColor="#D1FAE5"
                        android:textSize="11sp"
                        android:paddingTop="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnDashAddIncome"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="+ Add Income"
                        android:textSize="12sp"
                        android:backgroundTint="#059669"
                        android:textColor="#FFFFFF"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDashAddExpense"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="- Add Expense"
                        android:textSize="12sp"
                        android:backgroundTint="#DC2626"
                        android:textColor="#FFFFFF"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <EditText
                        android:id="@+id/etTransactionSearch"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:hint="Search"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                    <Spinner
                        android:id="@+id/spinnerSort"
                        android:layout_width="112dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnStartDate"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="Start date"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:padding="0dp" />
                    <Button
                        android:id="@+id/btnEndDate"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="End date"
                        android:textSize="11sp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard History (All Transactions)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="16dp" />

                <ListView
                    android:id="@+id/listViewDashboardHistory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:divider="@null"
                    android:dividerHeight="8dp" />
            </LinearLayout>

            <!-- 2. USER TAB VIEW -->
            <LinearLayout
                android:id="@+id/viewUser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Management"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F5132"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Switch Active User:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#475569" />

                <Spinner
                    android:id="@+id/spinnerUsersTab"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:background="@android:drawable/btn_dropdown" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New User Account:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#475569" />

                <EditText
                    android:id="@+id/etNewUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter User Name (e.g. Business, Juan)"
                    android:layout_marginTop="6dp"
                    android:inputType="textCapWords" />

                <Button
                    android:id="@+id/btnCreateUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create User"
                    android:backgroundTint="#0F5132"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp" />

                <!-- 🟢 DITO KO IDINAGDAG ANG RENAME BUTTON -->
                <Button
                    android:id="@+id/btnRenameUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rename Active User"
                    android:backgroundTint="#334155"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnDeleteUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delete Active User"
                    android:backgroundTint="#B91C1C"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnCreateCloudAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create cloud account"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnEditCloudEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Change cloud email"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnEditCloudPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Change cloud password"
                    android:layout_marginTop="8dp" />

                <!-- 🟢 DITO KO IDINAGDAG ANG BACK TO HOME BUTTON -->
                <Button
                    android:id="@+id/btnBackToHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Dashboard"
                    android:backgroundTint="#64748B"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 3. CHART TAB VIEW -->
            <LinearLayout
                android:id="@+id/viewChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expense Chart"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F5132"
                    android:layout_marginBottom="12dp" />

                <com.budgety.myapp.BarChartView
                    android:id="@+id/categoryBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Expense spending by category" />
            </LinearLayout>

            <!-- 4. DEBT TAB VIEW -->
            <LinearLayout
                android:id="@+id/viewDebt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debt Tracker"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F5132"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnAddDebt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add debt"
                    android:backgroundTint="#334155"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debts (check paid)"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp" />
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:id="@+id/debtRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- 5. HISTORY TAB VIEW -->
            <LinearLayout
                android:id="@+id/viewHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full History Logs"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F5132"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleHistoryFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:checkedButton="@id/btnFilterAll">

                    <Button
                        android:id="@+id/btnFilterAll"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="All Logs" />

                    <Button
                        android:id="@+id/btnFilterIncome"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Incomes" />

                    <Button
                        android:id="@+id/btnFilterExpense"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expenses" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <ListView
                    android:id="@+id/listViewFullHistory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:divider="@null"
                    android:dividerHeight="8dp" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- SIDE NAVIGATION TAB (LEFT DRAWER MENU) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true">

        <!-- Drawer Header with Hide Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#0F5132">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Navigation Menu"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHideNav"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Hide Nav" />
        </LinearLayout>

        <!-- Menu Tabs List -->
        <TextView
            android:id="@+id/btnNavDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊  Dashboard"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:padding="18dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnNavChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊  Expense Chart"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:padding="18dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnNavDebt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳  Debt Tracker"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:padding="18dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnNavUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤  User Management"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:padding="18dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnNavHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📜  History Logs"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:padding="18dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>